# Local Supabase (npm run db:start prints these). The simulator can reach 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Where invite links point (apps/web)
EXPO_PUBLIC_INVITE_BASE_URL=http://localhost:3000
# Share to Story (optional). Without these, Share to Story uses the share sheet only.
# Facebook App ID for Instagram Stories sharing (developers.facebook.com → your app → App ID)
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Snap Kit OAuth client ID with Creative Kit enabled (kit.snapchat.com). Native config: needs a new prebuild/build.
EXPO_PUBLIC_SNAP_CLIENT_ID=
