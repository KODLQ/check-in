# Local defaults for `supabase functions serve` (copy to supabase/functions/.env).
# Production values are set with `supabase secrets set` (see notifications-worker/README.md).
NOTIFICATIONS_WORKER_SECRET=dev-only-worker-secret
# smtp = Mailpit (local), resend = production
EMAIL_TRANSPORT=smtp
SMTP_HOST=inbucket
SMTP_PORT=1025
EMAIL_FROM=check-in <updates@checkin.test>
# Public web origin for invite and unsubscribe links in emails
WEB_BASE_URL=http://localhost:3000
# Production only
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EXPO_ACCESS_TOKEN=
EMAIL_UNSUBSCRIBE_MAILTO=
